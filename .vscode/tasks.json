{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Project (make)",
            "type": "shell",
            "command": "make",
            "args": [],                           // add e.g. ["clean"] or ["-j8"] if you want
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "options": {
                "env": {
                    "DEVKITPRO": "C:\\devkitPro",
                    "DEVKITPPC": "C:\\devkitPro\\devkitPPC"
                },
                "cwd": "${workspaceFolder}"       // optional, but good to be explicit
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "Clean Project",
            "type": "shell",
            "command": "make",
            "args": ["clean"],
            "options": {
                "env": {
                    "DEVKITPRO": "C:\\devkitPro",
                    "DEVKITPPC": "C:\\devkitPro\\devkitPPC"
                }
            }
        }
    ]
}